{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "/home/afterlight/.config/fastfetch/assets/roxy-logo.png",
    "width": 14,
    "position": "top",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 0
    }
  },

  "display": {
    "separator": " 󰁔 ",
    "brightColor": true,

    "color": {
      "keys": "#8CB4FF",
      "title": "#C6A9FF",
      "output": "#DDE7FF",
      "separator": "#7788FF"
    },

    "key": {
      "width": 14,
      "type": "string"
    },

    "percent": {
      "type": 1
    }
  },

  "modules": [
    {
      "type": "custom",
      "format": "{#title}╭─ ✦ ROXY'S GRIMOIRE ✦ ─╮{#}"
    },
    {
      "type": "title",
      "format": "{#title}   {user-name}@{host-name}{#}"
    },

    {
      "type": "custom",
      "format": "{#keys}├─ SYSTEM ──────────────┤{#}"
    },
    {
      "type": "os",
      "key": "│   OS"
    },
    {
      "type": "host",
      "key": "│ 󰌢  Machine"
    },
    {
      "type": "kernel",
      "key": "│   Kernel"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐  Uptime"
    },

    {
      "type": "custom",
      "format": "{#keys}├─ HARDWARE ────────────┤{#}"
    },
    {
      "type": "cpu",
      "key": "│   CPU",
      "temp": false
    },
    {
      "type": "gpu",
      "key": "│ 󰢮  GPU"
    },
    {
      "type": "memory",
      "key": "│   RAM"
    },

    {
      "type": "custom",
      "format": "{#keys}├─ DESKTOP ─────────────┤{#}"
    },
    {
      "type": "shell",
      "key": "│   Shell"
    },

    {
      "type": "custom",
      "format": "{#title}╰───────────────────────╯{#}"
    }
  ]
}
