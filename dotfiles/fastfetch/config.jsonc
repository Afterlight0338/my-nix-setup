{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "/home/afterlight/.config/fastfetch/assets/roxy-logo.png",
    "width": 30,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },

  "display": {
    "separator": "",
    "color": {
      "keys": "#8CB4FF",
      "title": "#C6A9FF",
      "output": "#DDE7FF",
      "separator": "#7788FF"
    }
  },

  "modules": [
    {
      "type": "command",
      "key": " ",
      "text": "$HOME/.local/bin/render-grimoire"
    }
  ]
}
