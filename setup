#!/usr/bin/env bash
# Sets this flake up on a machine: detects the hardware, asks for a mode (lite, minimal,
# full, afterlight), writes hosts/<hostname>/,
# checks that it evaluates, installs the dotfiles, and optionally switches to it.
# Nothing on the system changes until the last two questions.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
# Flakes and the wizard need git; a fresh NixOS install often has none
command -v git >/dev/null || exec nix-shell -p git --run "$(printf "%q " "$0" "$@")"

bold=$'\e[1m' dim=$'\e[2m' blue=$'\e[34m' green=$'\e[32m' red=$'\e[31m' reset=$'\e[0m'
step() { printf '\n%s==>%s %s%s%s\n' "$blue$bold" "$reset" "$bold" "$1" "$reset"; }
info() { printf '  %s\n' "$1"; }
ok() { printf '  %s%s%s\n' "$green" "$1" "$reset"; }
fail() { printf '  %s%s%s\n' "$red" "$1" "$reset"; }

# ask "question" y|n  -> exit status
ask() {
  local hint="[Y/n]" reply
  [[ $2 == n ]] && hint="[y/N]"
  while true; do
    read -rp "  $1 $dim$hint$reset " reply
    case "${reply:-$2}" in
      [yY]*) return 0 ;;
      [nN]*) return 1 ;;
    esac
  done
}
# yn "question" y|n -> prints true/false
yn() { ask "$1" "$2" && echo true || echo false; }
# input "question" default -> prints the answer
input() {
  local reply
  read -rp "  $1 ${dim}[$2]${reset} " reply
  echo "${reply:-$2}"
}

# PCI address from an `lspci -nn` line ("75:00.0 ...") as PCI:bus:device:function in decimal
bus_id() {
  local a=${1%% *} b d f
  b=${a%%:*} d=${a#*:}
  f=${d#*.} d=${d%%.*}
  echo "PCI:$((16#$b)):$((16#$d)):$f"
}

step "Hardware (auto-detected)"
vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || echo unknown)
product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo unknown)
laptop=false
case "$(cat /sys/class/dmi/id/chassis_type 2>/dev/null)" in 8|9|10|11|14|30|31|32) laptop=true ;; esac
ls /sys/class/power_supply/BAT* >/dev/null 2>&1 && laptop=true
acer=false
$laptop && [[ "$vendor $product" == *[Aa]cer* ]] && acer=true

# Match on PCI vendor IDs: nvidia 10de, amd 1002, intel 8086
gpus=$(lspci -nn 2>/dev/null | grep -E '\[03(00|02|80)\]' || true)
nvidia=false amd=false intel=false
prime_amd="" prime_nvidia=""
while read -r line; do
  case "$line" in
    *"[10de:"*) nvidia=true prime_nvidia=$(bus_id "$line") ;;
    *"[1002:"*) amd=true prime_amd=$(bus_id "$line") ;;
    *"[8086:"*) intel=true ;;
  esac
done <<< "$gpus"
bluetooth=false
[[ -d /sys/class/bluetooth ]] && bluetooth=true
# CachyOS's GRUB on the ESP: my boot bridge only makes sense next to it
cachy_grub=false
[[ -f /boot/EFI/cachyos/grubx64.efi ]] && cachy_grub=true

info "$vendor $product ($($laptop && echo laptop || echo desktop))"
info "$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ *//')"
while read -r line; do [[ -n $line ]] && info "${line#*: }"; done <<< "$gpus"

step "Mode"
info "1  lite        does nothing. Why are you even using this script?"
info "2  minimal     only what's needed: Hyprland, Caelestia (Roxy theme) and osu!"
info "3  full        the important parts of my system: gaming, apps, tablet, kernel, dev tools"
info "4  afterlight  1:1 my host (drives, Kali VM network, boot bridge, ...), except passwords"
mode=${1:-}
if [[ -z $mode ]]; then
  case "$(input "Choice" 3)" in
    1) mode=lite ;; 2) mode=minimal ;; 3) mode=full ;; 4) mode=afterlight ;;
    *) mode=full ;;
  esac
fi

if [[ $mode == lite ]]; then
  info "Lite mode: nothing installed, nothing changed. Why are you even using this script?"
  exit 0
fi

hyprland=true gaming=true osu=true osu_wine=true apps=true devtools=true filemgr=true
otd=true otd_preset=true webhid=true splash=true autologin=false cachyos=true damx=$acer
bridge=false
case "$mode" in
  minimal)
    gaming=false osu_wine=false apps=false devtools=false filemgr=false
    otd=false otd_preset=false webhid=false splash=false cachyos=false damx=false
    ;;
  full) ;;
  afterlight)
    autologin=true bridge=$cachy_grub
    ;;
  *) fail "Unknown mode '$mode' (lite, minimal, full, afterlight)"; exit 1 ;;
esac

step "User"
if [[ $mode == afterlight ]]; then
  user=afterlight
  info "The user is 'afterlight', like the original. Passwords aren't part of the config:"
  info "set one after switching with: sudo passwd afterlight"
else
  user=$(input "Username" "${SUDO_USER:-${USER:-nixos}}")
fi
host=$(input "Hostname" "$(cat /etc/hostname 2>/dev/null || echo nixos)")
cfg=$host
[[ $cfg == nixos ]] && cfg=this-machine
dir="hosts/$cfg"
if [[ -e $dir/default.nix ]] && ! ask "$dir already exists. Overwrite it?" n; then
  info "Nothing changed."
  exit 0
fi

step "Writing $dir"
mkdir -p "$dir"
if [[ -f /etc/nixos/hardware-configuration.nix ]]; then
  cp /etc/nixos/hardware-configuration.nix "$dir/"
else
  nixos-generate-config --show-hardware-config > "$dir/hardware-configuration.nix"
fi

imports="./hardware-configuration.nix"
user_block=""
if [[ $mode == afterlight ]]; then
  imports="$imports ../nixos/personal.nix"
  $bridge && imports="$imports ../nixos/boot-bridge.nix"
else
  user_block="    user.name = \"$user\";
    user.description = \"${user^}\";
"
fi
prime_block=""
if $nvidia && $amd && [[ -n $prime_amd && -n $prime_nvidia ]]; then
  prime_block="      nvidia.prime.amdBusId = \"$prime_amd\";
      nvidia.prime.nvidiaBusId = \"$prime_nvidia\";
"
fi

cat > "$dir/default.nix" <<NIX
{ lib, ... }:

# Written by ./setup ($mode mode) on $(date +%F). Options are described in modules/*.nix.
{
  imports = [ $imports ];

  networking.hostName = "$host";

  custom = {
$user_block
    desktop = {
      hyprland.enable = $hyprland;
      theme.enable = $hyprland;
      fileManager.enable = $filemgr;
      splash.enable = $splash;
      autologin.enable = $autologin;
    };

    hardware = {
      nvidia.enable = $nvidia;
$prime_block      amdGpu.enable = $amd;
      intelGpu.enable = $intel;
      bluetooth.enable = $bluetooth;
      laptop = {
        enable = $laptop;
        damx = $damx;
        linuwuSense = $damx;
      };
      cachyosKernel.enable = $cachyos;
      opentabletdriver.enable = $otd;
      webhid.enable = $webhid;
    };

    gaming.enable = $gaming;
    gaming.osu = {
      enable = $osu;
      wine = $osu_wine;
    };

    apps.enable = $apps;
    apps.devTools.enable = $devtools;
  };

  boot.loader.systemd-boot.enable = lib.mkDefault true;
  boot.loader.efi.canTouchEfiVariables = lib.mkDefault true;

  system.stateVersion = "26.05";
}
NIX
# Flakes only see files git knows about
[[ -d .git ]] && git add -N "$dir"
ok "Done"

step "Checking it evaluates"
if nix --extra-experimental-features "nix-command flakes" eval --raw ".#nixosConfigurations.$cfg.config.system.build.toplevel.drvPath" >/dev/null; then
  ok "Looks good"
else
  fail "It doesn't evaluate (error above). Your system hasn't been touched."
  exit 1
fi

stamp=$(date +%Y%m%d%H%M%S)
# install_dotfiles <home> <owner> [sudo]
install_dotfiles() {
  local home=$1 owner=$2 sx=${3:-} name f src
  # dotfiles/<app> replaces ~/.config/<app> (the old folder is kept as <app>.backup-<time>)
  for src in dotfiles/*/; do
    name=$(basename "$src")
    [[ $name == OpenTabletDriver ]] && ! $otd_preset && continue
    [[ -d $home/.config/$name ]] && $sx mv "$home/.config/$name" "$home/.config/$name.backup-$stamp"
    $sx mkdir -p "$home/.config"
    $sx cp -ra "$src" "$home/.config/$name"
  done
  # home/ mirrors files elsewhere in your home folder (scripts, ~/.zshrc, ...)
  while read -r f; do
    f=${f#./}
    $sx mkdir -p "$(dirname "$home/$f")"
    [[ -e $home/$f ]] && ! cmp -s "home/$f" "$home/$f" && $sx cp -a "$home/$f" "$home/$f.backup-$stamp"
    $sx cp -a "home/$f" "$home/$f"
  done < <(cd home && find . -type f)
  [[ -n $sx ]] && $sx chown -R "$owner:users" "$home"
  return 0
}

step "Dotfiles"
dotfiles_later=false
if ! $hyprland; then
  info "Hyprland is off, nothing to copy."
elif [[ $mode == afterlight && ${USER:-} != afterlight ]]; then
  # The afterlight user only exists after the switch, so its dotfiles go in then
  dotfiles_later=true
  info "They'll be copied into /home/afterlight after the switch."
elif ask "Install the Hyprland / Roxy dotfiles into your home folder?" y; then
  home=$(getent passwd "$user" | cut -d: -f6)
  install_dotfiles "${home:-$HOME}" "$user" "$([[ -n ${SUDO_USER:-} ]] && echo sudo)"
  ok "Installed (anything replaced was kept as *.backup-$stamp)"
fi

step "Switch"
if ask "Build and switch to $cfg now?" y; then
  [[ -d /etc/nixos && ! -d /etc/nixos.wizard-backup ]] && sudo cp -ra /etc/nixos /etc/nixos.wizard-backup
  if sudo nixos-rebuild switch --flake ".#$cfg"; then
    ok "Switched. If anything's wrong: sudo nixos-rebuild switch --rollback"
    if $dotfiles_later && ask "Copy the dotfiles into /home/afterlight now?" y; then
      install_dotfiles /home/afterlight afterlight sudo
      ok "Installed"
    fi
    [[ $mode == afterlight ]] && info "Set the password: sudo passwd afterlight"
  else
    fail "The build failed, so your current system is still the active one."
    exit 1
  fi
else
  info "Later: sudo nixos-rebuild switch --flake .#$cfg"
  $dotfiles_later && info "and copy dotfiles/ and home/ into /home/afterlight yourself."
fi
