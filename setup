#!/usr/bin/env bash
# Sets this flake up on a machine: detects the hardware, writes hosts/<hostname>/,
# checks that it evaluates, installs the dotfiles, and optionally switches to it.
# Nothing on the system changes until the last two questions.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

bold=$'\e[1m' dim=$'\e[2m' blue=$'\e[34m' green=$'\e[32m' red=$'\e[31m' reset=$'\e[0m'
step() { printf '\n%s==>%s %s%s%s\n' "$blue$bold" "$reset" "$bold" "$1" "$reset"; }
info() { printf '  %s\n' "$1"; }
ok() { printf '  %s%s%s\n' "$green" "$1" "$reset"; }
fail() { printf '  %s%s%s\n' "$red" "$1" "$reset"; }

# ask "question" y|n  -> exit status
ask() {
  local hint="[Y/n]" reply
  [[ $2 == n ]] && hint="[y/N]"
  while true; do
    read -rp "  $1 $dim$hint$reset " reply
    case "${reply:-$2}" in
      [yY]*) return 0 ;;
      [nN]*) return 1 ;;
    esac
  done
}
# yn "question" y|n -> prints true/false
yn() { ask "$1" "$2" && echo true || echo false; }
# input "question" default -> prints the answer
input() {
  local reply
  read -rp "  $1 ${dim}[$2]${reset} " reply
  echo "${reply:-$2}"
}

step "Hardware"
vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || echo unknown)
product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo unknown)
laptop=false
case "$(cat /sys/class/dmi/id/chassis_type 2>/dev/null)" in 8|9|10|11|14|30|31|32) laptop=true ;; esac
ls /sys/class/power_supply/BAT* >/dev/null 2>&1 && laptop=true
acer=false
$laptop && [[ "$vendor $product" == *[Aa]cer* ]] && acer=true

gpus=$(lspci 2>/dev/null | grep -iE 'vga|3d|display' || true)
nvidia=false amd=false intel=false
grep -qi nvidia <<< "$gpus" && nvidia=true
grep -qiE 'amd|ati|radeon' <<< "$gpus" && amd=true
grep -qi intel <<< "$gpus" && intel=true
bluetooth=false
[[ -d /sys/class/bluetooth ]] && bluetooth=true

info "$vendor $product ($($laptop && echo laptop || echo desktop))"
info "$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ *//')"
while read -r line; do [[ -n $line ]] && info "${line#*: }"; done <<< "$gpus"

step "What to install"
info "1  Everything: Hyprland + Roxy theme, Steam, osu!, apps, tablet driver, boot splash"
info "2  Minimal: Hyprland + Roxy theme and the basics"
info "3  Ask me about each part"
profile=$(input "Choice" 1)

hyprland=true gaming=true osu=true apps=true otd=true otd_preset=true webhid=false
splash=true autologin=false cachyos=false damx=$acer
case "$profile" in
  2)
    gaming=false osu=false otd=false otd_preset=false splash=false damx=false
    ;;
  3)
    if ! ask "Is the hardware above right?" y; then
      nvidia=$(yn "NVIDIA GPU?" "$($nvidia && echo y || echo n)")
      amd=$(yn "AMD GPU (including integrated)?" "$($amd && echo y || echo n)")
      intel=$(yn "Intel GPU (including integrated)?" "$($intel && echo y || echo n)")
      laptop=$(yn "Laptop?" "$($laptop && echo y || echo n)")
    fi
    hyprland=$(yn "Hyprland with the Roxy theme?" y)
    gaming=$(yn "Steam and GameMode?" y)
    osu=$(yn "osu! (lazer, and stable through wine-osu)?" y)
    apps=$(yn "Desktop apps (Brave, Discord, mpv, ...)?" y)
    otd=$(yn "Drawing tablet (OpenTabletDriver)?" n)
    otd_preset=false
    $otd && otd_preset=$(yn "Copy my tablet area and filters (67.67x39.39 mm, rotated 180)?" n)
    webhid=$(yn "Access for custom keyboards/keypads (WebHID, RP2040, ...)?" n)
    $acer && damx=$(yn "Acer fan and performance controls (DAMX)?" n)
    cachyos=$(yn "CachyOS kernel (BORE scheduler, prebuilt)?" n)
    splash=$(yn "Roxy boot splash?" y)
    autologin=$(yn "Log in automatically (the session locks itself)?" n)
    ;;
esac

step "User"
user=$(input "Username" "${SUDO_USER:-${USER:-nixos}}")
host=$(input "Hostname" "$(cat /etc/hostname 2>/dev/null || echo nixos)")
dir="hosts/$host"
if [[ -e $dir/default.nix ]] && ! ask "$dir already exists. Overwrite it?" n; then
  info "Nothing changed."
  exit 0
fi

step "Writing $dir"
mkdir -p "$dir"
if [[ -f /etc/nixos/hardware-configuration.nix ]]; then
  cp /etc/nixos/hardware-configuration.nix "$dir/"
else
  nixos-generate-config --show-hardware-config > "$dir/hardware-configuration.nix"
fi

cat > "$dir/default.nix" <<EOF
{ lib, ... }:

# Written by ./setup on $(date +%F). Options are described in modules/*.nix.
{
  imports = [ ./hardware-configuration.nix ];

  networking.hostName = "$host";

  custom = {
    user.name = "$user";
    user.description = "${user^}";

    desktop = {
      hyprland.enable = $hyprland;
      theme.enable = $hyprland;
      fileManager.enable = $hyprland;
      splash.enable = $splash;
      autologin.enable = $autologin;
    };

    hardware = {
      nvidia.enable = $nvidia;
      amdGpu.enable = $amd;
      intelGpu.enable = $intel;
      bluetooth.enable = $bluetooth;
      laptop = {
        enable = $laptop;
        damx = $damx;
        linuwuSense = $damx;
      };
      cachyosKernel.enable = $cachyos;
      opentabletdriver.enable = $otd;
      webhid.enable = $webhid;
    };

    gaming.enable = $gaming;
    gaming.osu = {
      enable = $osu;
      wine = $osu;
    };

    apps.enable = $apps;
  };

  boot.loader.systemd-boot.enable = lib.mkDefault true;
  boot.loader.efi.canTouchEfiVariables = lib.mkDefault true;

  system.stateVersion = "26.05";
}
EOF
# Flakes only see files git knows about
[[ -d .git ]] && git add -N "$dir"
ok "Done"

step "Checking it evaluates"
if nix --extra-experimental-features "nix-command flakes" eval --raw ".#nixosConfigurations.$host.config.system.build.toplevel.drvPath" >/dev/null; then
  ok "Looks good"
else
  fail "It doesn't evaluate (error above). Your system hasn't been touched."
  exit 1
fi

step "Dotfiles"
if ask "Install the Hyprland / Roxy dotfiles into your home folder?" y; then
  home=$(getent passwd "$user" | cut -d: -f6)
  home=${home:-$HOME}
  stamp=$(date +%Y%m%d%H%M%S)
  # dotfiles/<app> replaces ~/.config/<app> (the old folder is kept as <app>.backup-<time>)
  for src in dotfiles/*/; do
    name=$(basename "$src")
    [[ $name == OpenTabletDriver ]] && ! $otd_preset && continue
    [[ -d $home/.config/$name ]] && mv "$home/.config/$name" "$home/.config/$name.backup-$stamp"
    mkdir -p "$home/.config"
    cp -ra "$src" "$home/.config/$name"
  done
  # home/ mirrors files elsewhere in your home folder (scripts, ~/.zshrc, ...)
  (cd home && find . -type f) | while read -r f; do
    f=${f#./}
    mkdir -p "$(dirname "$home/$f")"
    [[ -e $home/$f ]] && ! cmp -s "home/$f" "$home/$f" && cp -a "$home/$f" "$home/$f.backup-$stamp"
    cp -a "home/$f" "$home/$f"
  done
  [[ -n ${SUDO_USER:-} ]] && chown -R "$user:users" "$home/.config" "$home/.local" "$home/.zshrc" 2>/dev/null
  ok "Installed (anything replaced was kept as *.backup-$stamp)"
fi

step "Switch"
if ask "Build and switch to $host now?" y; then
  [[ -d /etc/nixos && ! -d /etc/nixos.wizard-backup ]] && sudo cp -ra /etc/nixos /etc/nixos.wizard-backup
  if sudo nixos-rebuild switch --flake ".#$host"; then
    ok "Switched. If anything's wrong: sudo nixos-rebuild switch --rollback"
  else
    fail "The build failed, so your current system is still the active one."
    exit 1
  fi
else
  info "Later: sudo nixos-rebuild switch --flake .#$host"
fi
