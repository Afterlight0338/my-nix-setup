 {"key":"gestureFingers","tab":"advanced","section":"Touchpad","label":"Gesture fingers","type":"int","min":3,"max":5},
 {"key":"workspaceSwipeFingers","tab":"advanced","section":"Touchpad","label":"Workspace swipe fingers","type":"int","min":3,"max":5},

 {"key":"cursorTheme","tab":"advanced","section":"Cursor & volume","label":"Cursor theme","type":"text"},
 {"key":"cursorSize","tab":"advanced","section":"Cursor & volume","label":"Cursor size","type":"int","min":16,"max":64},
