#!/usr/bin/env bash
# Backend for the Rice Settings page in the keybind cheat sheet (~/.config/quickshell/cheatsheet).
#   rice-settings get              every setting as JSON: schema + current value
#   rice-settings set KEY VALUE    write it where it already lives, then apply it live where possible
#   rice-settings apply-gamma      (re)start wl-gammactl with the saved gamma (run at login)
# Each setting stays in its original file, so the old commands and hotkeys keep working.
set -uo pipefail

HV="$HOME/.config/caelestia/hypr-vars.lua"      # overrides
HV_DEFAULTS="$HOME/.config/hypr/variables.lua"  # Caelestia defaults
HU="$HOME/.config/caelestia/hypr-user.lua"
KITTY="$HOME/.config/kitty/kitty.conf"
ZSHRC="$HOME/.zshrc"
FF="$HOME/.local/bin/fastfetch"
BAR="$HOME/.local/bin/bar-peek"
ENVH="$HOME/.config/uwsm/env-hyprland"
SHELLJSON="$HOME/.config/caelestia/shell.json"
DARKLY="$HOME/.config/darklyrc"
GAMMA_STATE="$HOME/.cache/wl-gamma"
NIGHT="$HOME/.config/hypr/hyprsunset.conf"

schema() {
  cat <<'EOF'
[
 {"key":"fastfetch_lang","tab":"simple","section":"Language","label":"Fastfetch language","type":"choice","options":[["en","English"],["ja","日本語"]]},
 {"key":"japanese_workspaces","tab":"simple","section":"Language","label":"Japanese workspace numbers (一 二 三)","type":"bool"},

 {"key":"fastfetch_greet","tab":"simple","section":"Terminal","label":"Fastfetch when a terminal opens","type":"bool"},
 {"key":"kitty_opacity","tab":"simple","section":"Terminal","label":"Terminal opacity","type":"slider","min":0.3,"max":1,"step":0.05},
 {"key":"cursor_trail","tab":"simple","section":"Terminal","label":"Cursor trail","type":"bool"},
 {"key":"zsh_autosuggest","tab":"simple","section":"Terminal","label":"Command suggestions (new terminals)","type":"bool"},
 {"key":"zsh_highlight","tab":"simple","section":"Terminal","label":"Command colouring (new terminals)","type":"bool"},
 {"key":"qt_opacity","tab":"simple","section":"Terminal","label":"Qt apps opacity (Dolphin, Kate…; reopen them)","type":"slider","min":0.3,"max":1,"step":0.05},

 {"key":"bar_hide_secs","tab":"simple","section":"Desktop","label":"Bar hides after (Super+B), 0 = never","type":"slider","min":0,"max":300,"step":10,"unit":"s"},
 {"key":"blur_preset","tab":"simple","section":"Desktop","label":"Blur strength","type":"choice","options":[["low","Low"],["medium","Medium"],["high","High"]]},
 {"key":"gamma","tab":"simple","section":"Desktop","label":"Screen gamma","type":"slider","min":0.5,"max":1.5,"step":0.05},
 {"key":"dnd","tab":"simple","section":"Desktop","label":"Do Not Disturb (Super+Shift+N)","type":"bool"},
 {"key":"animated_border","tab":"simple","section":"Desktop","label":"Animated window border","type":"bool"},
 {"key":"lock_on_login","tab":"simple","section":"Desktop","label":"Lock screen on login","type":"bool"},

 {"key":"night_light","tab":"simple","section":"Night light","label":"Night light","type":"choice","options":[["off","Off"],["schedule","Schedule"],["always","Always"]]},
 {"key":"night_temp","tab":"simple","section":"Night light","label":"Warmth (lower = warmer)","type":"slider","min":2500,"max":6000,"step":100,"unit":"K"},
 {"key":"night_start","tab":"simple","section":"Night light","label":"Starts at","type":"time"},
 {"key":"night_end","tab":"simple","section":"Night light","label":"Ends at","type":"time"},

 {"key":"osu_auto_game_mode","tab":"simple","section":"Gaming","label":"osu! turns on game mode","type":"bool"},
 {"key":"game_mode","tab":"simple","section":"Gaming","label":"Game mode right now","type":"bool"},

 {"key":"folder_color","tab":"simple","section":"Wallpaper & GPU","label":"Folder colour (reopen apps)","type":"choice","options":[["blue","Blue"],["indigo","Indigo"],["nordic","Nordic"],["violet","Violet"],["cyan","Cyan"]]},
 {"key":"questionable_wallpapers","tab":"simple","section":"Wallpaper & GPU","label":"Questionable wallpapers","type":"bool"},
 {"key":"gpu_mode","tab":"simple","section":"Wallpaper & GPU","label":"Desktop GPU (next login)","type":"choice","options":[["auto","Auto"],["amd","AMD"],["nvidia","NVIDIA"]]},

 {"key":"terminal","tab":"simple","section":"Default apps","label":"Terminal","type":"text"},
 {"key":"browser","tab":"simple","section":"Default apps","label":"Browser","type":"text"},
 {"key":"editor","tab":"simple","section":"Default apps","label":"Editor","type":"text"},
 {"key":"fileExplorer","tab":"simple","section":"Default apps","label":"File manager","type":"text"},
 {"key":"audioSettings","tab":"simple","section":"Default apps","label":"Audio settings","type":"text"},

 {"key":"windowGapsIn","tab":"advanced","section":"Windows","label":"Gap between windows","type":"int","min":0,"max":30},
 {"key":"windowGapsOut","tab":"advanced","section":"Windows","label":"Gap to screen edge","type":"int","min":0,"max":60},
 {"key":"singleWindowGapsOut","tab":"advanced","section":"Windows","label":"Edge gap, single window","type":"int","min":0,"max":80},
 {"key":"workspaceGaps","tab":"advanced","section":"Windows","label":"Workspace gaps","type":"int","min":0,"max":80},
 {"key":"windowRounding","tab":"advanced","section":"Windows","label":"Corner rounding","type":"int","min":0,"max":30},
 {"key":"windowBorderSize","tab":"advanced","section":"Windows","label":"Border size","type":"int","min":0,"max":6},
 {"key":"windowOpacity","tab":"advanced","section":"Windows","label":"Window opacity","type":"slider","min":0.5,"max":1,"step":0.05},

 {"key":"blurEnabled","tab":"advanced","section":"Blur","label":"Blur","type":"bool"},
 {"key":"blurSize","tab":"advanced","section":"Blur","label":"Blur size","type":"int","min":1,"max":20},
 {"key":"blurPasses","tab":"advanced","section":"Blur","label":"Blur passes","type":"int","min":1,"max":6},
 {"key":"blurPopups","tab":"advanced","section":"Blur","label":"Blur popups","type":"bool"},
 {"key":"blurXray","tab":"advanced","section":"Blur","label":"X-ray (blur only the wallpaper)","type":"bool"},
 {"key":"blurSpecialWs","tab":"advanced","section":"Blur","label":"Blur special workspaces","type":"bool"},
