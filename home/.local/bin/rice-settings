 {"key":"kitty_padding","tab":"advanced","section":"Terminal (kitty)","label":"Padding","type":"int","min":0,"max":40},
 {"key":"kitty_shade","tab":"advanced","section":"Terminal (kitty)","label":"Top shade background image","type":"bool"},
 {"key":"kitty_text","tab":"advanced","section":"Terminal (kitty)","label":"Text sharpness (gamma contrast)","type":"text"},

 {"key":"greet_min_cols","tab":"advanced","section":"Fastfetch","label":"Greet only if columns ≥","type":"int","min":40,"max":200},
 {"key":"greet_min_lines","tab":"advanced","section":"Fastfetch","label":"Greet only if lines ≥","type":"int","min":10,"max":80},
 {"key":"half_tile_cols","tab":"advanced","section":"Fastfetch","label":"Max width (half-screen tile)","type":"int","min":60,"max":200}
]
